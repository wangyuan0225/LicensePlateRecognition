# ============================================================
# 本地私密配置模板 — 克隆项目后将此文件复制为 application-local.yml
# ============================================================
# 使用步骤：
#   1. 将此文件复制并重命名为 application-local.yml
#   2. 填写你自己的数据库连接信息和邮箱授权码
#   3. application-local.yml 已被 .gitignore 忽略，不会泄露到 GitHub

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/lpr_db?useUnicode=true&characterEncoding=utf-8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
    username: root          # 替换为你的数据库用户名
    password: root          # 替换为你的数据库密码

  mail:
    host: smtp.qq.com       # 163 邮箱: smtp.163.com  QQ 邮箱: smtp.qq.com
    port: 465
    username: YOUR_EMAIL@qq.com   # 替换为你的发件邮箱
    password: YOUR_AUTH_CODE      # 邮箱"授权码"（非登录密码）
    protocol: smtps
    default-encoding: UTF-8
    properties:
      mail.smtp.ssl.enable: true
      mail.smtp.auth: true

app:
  mail:
    from: YOUR_EMAIL@qq.com       # 与 spring.mail.username 保持一致
    code-expire-minutes: 5
